<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BotServer</AssemblyName>
    <RootNamespace>ApiHawk</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- LangVersion is independent of TargetFramework: net48 is required because EmuHawk loads
         external tools in-process via Assembly.LoadFrom, but modern C# compiles fine against it. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BizHawk 2.11.2 reference DLLs, built from the ppicinic/BizHawk fork on branch
      fix/4535-sticky-analog (which carries the fix for TASEmulators/BizHawk#4535 —
      sticky analog being XOR-cancelled to neutral by mouse-bound axes).

      Refresh these by building that fork and copying from its output/ directory:
        <fork>\output\dll\BizHawk.Client.Common.dll
        <fork>\output\dll\BizHawk.Common.dll
        <fork>\output\dll\BizHawk.Emulation.Common.dll
        <fork>\output\EmuHawk.exe
      These are not deployed with the output — Private=false keeps them out of the build output.
    -->
    <Reference Include="BizHawk.Client.Common">
      <HintPath>lib\BizHawk.Client.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EmuHawk">
      <HintPath>lib\EmuHawk.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Common">
      <HintPath>lib\BizHawk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Emulation.Common">
      <HintPath>lib\BizHawk.Emulation.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Deploy with Scripts/deploy-apihawk.ps1 (EmuHawk closed): it builds, copies BotServer.dll to the
    BizHawk ExternalTools folder, and records its trust hash in BizHawk's config.
  -->
</Project>
